# KIN 리버스 프록시 — 브라우저가 보는 출처를 하나로 모은다.
# PUBLIC_PORT 계열만 envsubst한다. $host·$request_uri 같은 nginx 변수는 런타임까지 남아야 한다.

# 응답 머리글(Server)과 nginx가 그리는 화면에 판 번호를 싣지 않는다.
server_tokens off;


# S9-U4b 원본 archive(D1489)의 접근 기록: 메서드·정규화한 경로·상태·바이트·시각뿐이다. 그 GET의 query에는 일회용
# 다운로드 grant가 있으므로 $request·$request_uri·$args·$http_referer·Cookie·Authorization은 쓰지 않는다.
log_format kin_original_archive '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';
# grant는 정확한 archive 경로에서만 쓰이지만 클라이언트는 다른 표기(대문자 id·끝 빗금·/API/·상태 경로)에도 실어 보낼 수 있다.
# API는 그 요청을 소비 없이 거절하므로 일반 기록에 남은 grant는 만료(120초)까지 유효하다(SRU4-1). 그래서 query에 grant가
# 있으면 이 파일과 15-kin-config.envsh가 만드는 모든 server(기본 server 444 포함)가 위 형식으로만 기록하고, archive 경로가
# 아니면 upstream에 보내지 않고 server 수준에서 거절한다 — upstream 오류·deny의 원문 오류 기록과 HTTP→HTTPS 리다이렉트의
# Location은 요청 줄·query를 그대로 싣기 때문이다(U4C-01).
# "grant"의 표기: nginx는 $args를 디코딩하지 않지만 받는 쪽은 디코딩하므로 대소문자와 각 글자의 퍼센트 인코딩(%67rant·
# %47%52%41%4E%54), 그 인코딩 앞에 %25를 몇 번 더 붙인 것(%2567rant·%252567rant)을 같은 글자로 본다. 한 글자의 16진 숫자까지
# 따로 인코딩한 것(%25%36%37rant)은 이 판정 밖이다 — API는 query 전체가 문자 그대로 `grant=<43자>`일 때만 grant로 받으므로 그런
# 표기는 쓸 수 있는 grant 키가 아니다(SRU4R3-3).
# - kin_grant_key: query($args)의 어느 키가 그 표기로 시작한다(첫 키 또는 & ; 뒤). 443의 거절은 이 판정만 쓴다 — 값 속의
#   낱말(검색어 "grantham")은 키가 아니므로 막지 않는다.
# - kin_grant_query: 그 낱말이 요청 줄($request) 어디에든 있다(경로·다른 키의 값 포함). $args가 아니라 요청 줄로 보는 것은
#   nginx가 URI를 다 읽기 전에 끝낸 요청(414 등)에는 $args가 없고 이미지 main 기록은 요청 줄 전체를 싣기 때문이다(SRU4R3-2).
#   기록과 80 server의 거절을 이것으로 고른다 — 넓게 잡아도 그 요청의 query가 기록에서 빠지거나 HTTP 요청이 400일 뿐이다.
map $args $kin_grant_key {
    default                                                                                         0;
    "~*(^|[&;])(g|%(25)*[46]7)(r|%(25)*[57]2)(a|%(25)*[46]1)(n|%(25)*[46]e)(t|%(25)*[57]4)"         1;
}
map $request $kin_grant_query {
    default                                                                                         0;
    "~*(g|%(25)*[46]7)(r|%(25)*[57]2)(a|%(25)*[46]1)(n|%(25)*[46]e)(t|%(25)*[57]4)"                 1;
}
# HTTP→HTTPS 리다이렉트가 싣는 경로: 원문 요청 URI의 ? 앞까지. query는 옮기지 않는다(SRU4R3-3).
map $request_uri $kin_request_path {
    default      /;
    "~^(?<kin_path>[^?]*)"  $kin_path;
}map $kin_grant_query $kin_plain_log {
    0       1;
    default 0;
}
map "$kin_grant_key:$uri" $kin_grant_outside_archive {
    default                                                            0;
    "~^1:/api/studies/[0-9.]+/original-downloads/[0-9a-f-]+/archive$"  0;
    "~^1:"                                                             1;
}
# MG-08 IDR-03: 검사 UID 경로(/dicom-web/studies/<uid>)에서 기록 중계로 보낼 읽기 메서드. POST(STOW)는 0이다.
map $request_method $kin_image_read_method {
    default 0;
    GET     1;
    HEAD    1;
}
# 뷰어 앱 파일(/ohif/)의 브라우저 캐시. 내장 뷰어의 응답에는 Cache-Control도 검증자(ETag·Last-Modified)도 없어 새 뷰어 창·
# 새로고침마다 앱 전체(약 24 MB)를 다시 받았다. 이름에 내용 해시(16진 20자)가 들어간 번들·WebAssembly는 그 이름이 다른 내용을
# 내는 일이 없으므로 1년 동안 묻지 않고 쓰게 한다. 이름이 판마다 같은 파일(뷰어 페이지, app-config.js, <id>.css, 폴리필,
# 아이콘)은 쓸 때마다 다시 묻게(no-cache) 해서, 새 판을 올리면 새 페이지와 설정이 바로 읽히고 새 페이지가 새 번들 이름을 부른다.
# 영상·메타데이터·판독·업무 화면(/worklist/)의 캐시 정책은 이 값과 무관하다(빈 값이면 머리글을 내지 않는다). 오래 두는 것은
# 성공 응답뿐이고 /ohif/의 오류 응답은 no-store다 — 배포 중 아직 없는 번들의 404가 브라우저에 남지 않는다. 값은 응답 상태를
# 보고 정하므로 add_header는 always로 둔다(상태는 머리글을 쓸 때 정해져 있다).
# 제품 오류 화면(@kin_error_page)은 앞에 "error:"를 붙여 어느 주소의 실패든 no-store로 둔다(그 location에 add_header를 두면
# 위 보안 머리글의 상속이 끊기므로 이 map 하나로 한다).
map "$kin_error_page$status:$uri" $kin_app_cache_control {
    default                                                             "";
    "~^error:"                                                          "no-store";
    "~^20[06]:/ohif/([^/]+/)*([^/]+\.)?[0-9a-f]{20}\.(js|wasm)$"        "public, max-age=31536000, immutable";
    "~^[23][0-9][0-9]:/ohif/"                                           "no-cache";
    "~^[45][0-9][0-9]:/ohif/"                                           "no-store";
}
# 제품 오류 화면(@kin_error_page)의 한 줄: 무엇이 안 됐는지. 화면은 한 장이고 이 문장만 상태마다 다르다.
map $status $kin_error_line {
    default "요청을 처리하지 못했습니다. 잠시 뒤 다시 시도하세요.";
    401     "로그인이 필요합니다. 다시 로그인하세요.";
    403     "이 화면이나 자료를 열 권한이 없습니다.";
    404     "찾는 화면이 없습니다. 주소가 바뀌었거나 잘못 입력되었을 수 있습니다.";
    408     "요청이 제시간에 끝나지 않았습니다. 다시 시도하세요.";
    413     "보낸 파일이 너무 큽니다.";
    500     "서버가 지금 응답하지 않습니다. 잠시 뒤 다시 시도하세요.";
    502     "서버가 지금 응답하지 않습니다. 잠시 뒤 다시 시도하세요.";
    503     "서버가 지금 응답하지 않습니다. 잠시 뒤 다시 시도하세요.";
    504     "서버의 응답이 늦어 요청을 마치지 못했습니다. 잠시 뒤 다시 시도하세요.";
}
# 제품 오류 화면은 화면(/worklist/, 뷰어)과 같은 cross-origin isolation에 둔다. 다르면 그 창이 오류 화면을 여는 순간 다른
# browsing context group으로 옮겨져, 워크리스트가 쥔 이름 붙은 뷰어 창 핸들이 끊긴다(복구 뒤 창이 둘이 된다). 빈 값이면
# 머리글을 내지 않으므로 server 수준에 두어도 오류 화면 밖에는 붙지 않는다.
map $kin_error_page $kin_error_opener_policy {
    default "";
    "error:" "same-origin";
}
map $kin_error_page $kin_error_embedder_policy {
    default "";
    "error:" "require-corp";
}
# 그 archive의 API 연결은 응답 뒤에도 nginx가 먼저 끊지 않는다(keepalive). 끊으면 API의 writer가 마지막 byte를 넘긴 뒤 자기
# 응답을 끝내기 전에 연결이 닫혀, 끝까지 받은 다운로드가 Incomplete로 기록된다(S9-U4b (c) r2, hosted G3 dfca33a: nginx 200 전체
# byte, API attempt aborted·responseFinished false).
upstream kin_api_archive {
    server api:3000;
    keepalive 8;
}
# EMR-E 영상 경계(아래 프레임 location)도 같은 이유다: API가 마지막 byte 뒤 자기 응답을 끝내고 전송 종료를 기록하기 전에
# nginx가 연결을 닫으면 끝까지 보낸 프레임이 중단으로 남는다. 뷰어는 프레임을 동시에 여럿 받으므로 쉬는 연결을 더 둔다.
upstream kin_api_image {
    server api:3000;
    keepalive 16;
}

include /etc/nginx/snippets/default-servers.conf;
# 운영의 옛 주소(pacs.koreaimagingnetwork.com) 80·443 server: 새 주소로 301만 하고 옛 인증서·ACME 갱신을 유지한다.
# 15-kin-config.envsh가 운영 모드에서만 쓰고 개발에서는 비어 있다.
include /etc/nginx/snippets/legacy-host.conf;

server {
    listen 80;
    server_name ${SERVER_NAME};
    # 이 server는 리다이렉트만 하므로 query가 기록에 쓸모없다: 모든 요청을 query 없는 archive 형식으로만 기록한다 — 판정 밖의
    # 표기(SRU4R3-3)도 남지 않는다. 443 server와 기본 server(15-kin-config.envsh)는 grant 없는 요청에 이미지 main 기록을 둔다.
    access_log /var/log/nginx/access.log kin_original_archive;
    # 브라우저는 HTTP로 grant를 보내지 않는다. 요청 줄에 그 낱말이 있으면(어느 표기·위치든) 옮기지 않고 거절하고, 그 밖의
    # 리다이렉트도 경로만 옮기고 query는 버린다 — 어떤 값도 Location·브라우저 기록에 실리지 않는다(U4C-01, SRU4R3-3).
    if ($kin_grant_query) { return 400; }

    include /etc/nginx/snippets/acme-challenge.conf;

    # 서버 수준 return은 location 선택보다 먼저 실행되어 ACME webroot까지 리다이렉트한다.
    # challenge만 예외로 남기기 위해 일반 요청의 리다이렉트를 location에 둔다.
    location / {
        return 301 https://$host${PUBLIC_PORT_SUFFIX}$kin_request_path;
    }
}

server {
    listen 443 ssl;
    http2 on;
    # A11-OUTPUT / s9u4 re-login: 기본 keepalive_requests 1000 / keepalive_time 1h의 GOAWAY와
    # Chromium의 새 스트림 생성이 겹치면 요청이 ERR_FAILED로 사라진다. OHIF의 HTTP/2 병렬 요청을
    # 유지하며 계정 전환 84회에서 관측한 총 14580요청보다 위에서 연결을 교체한다.
    # 새 한도와 1h 만료의 경합은 남는다. 더 큰 기관/영상 부하에서는 먼저 다시 계측한다.
    keepalive_requests 14581;
    server_name ${SERVER_NAME};

    ssl_certificate     ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # nginx가 컨테이너의 443으로 절대 URL을 만들면 로컬 호스트의 9443을 잃는다.
    # 상대 리다이렉트는 브라우저가 현재 보고 있는 출처를 그대로 보존한다.
    absolute_redirect off;

    # 전역 기본. 큰 본문을 받는 곳은 Gateway 전용 지정형 STOW(아래 /dicom-web/studies/<uid>)와 member 반입의
    # 정확 경로(location = /api/dicom-import) 둘뿐이다(그 밖에 문서 붙이기 경로가 65m). 그 밖의 DICOM 쓰기는 limit_except로
    # 막혀 있고 나머지 /api/는 2m이다.
    client_max_body_size 32m;
    proxy_read_timeout   300s;
    proxy_send_timeout   300s;

    proxy_http_version 1.1;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    # 접속지는 프록시가 본 주소 하나다(S7-U5 A007·SEA-F04). 클라이언트가 보낸 X-Forwarded-For를 앞에 이어 붙이지 않는다 —
    # Keycloak은 이 머리글의 맨 앞 값을 접속지로 읽으므로(KC_PROXY_HEADERS=xforwarded), 이 서버 수준 값을 물려받는
    # location(가입 제출·토큰 교환의 정확 경로 등)에서 클라이언트가 고른 주소가 기록·제한의 기준이 되었다. API는 X-Real-IP만 읽는다.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  ${PUBLIC_PORT};

    include /etc/nginx/snippets/hsts.conf;
    include /etc/nginx/snippets/keycloak-admin-guards.conf;

    # Keycloak 계정 콘솔(S7-U5 A018). 제품은 이 화면을 쓰지 않고 어디에서도 가리키지 않는다. 열어 두면 Keycloak 자신의
    # SSO만으로 열려 제품의 콜백(끝내기로 한 세션을 막는 자리)을 지나지 않는다 — 제품이 세션을 끝낸 뒤 인증 서버의 종료가
    # 확인되기 전의 틈에 다음 사람이 앞사람의 계정 화면에 닿는다. 로그인·가입·비밀번호 재설정·필수 동작
    # (login-actions, protocol/openid-connect — Change Password의 UPDATE_PASSWORD 동작 포함)과 테마 자산(resources)은
    # 다른 경로라 영향이 없다. 접속기록 신원(이메일·이름)의 다른 본인 수정 길은 렐름이 UPDATE_PROFILE·VERIFY_PROFILE을
    # 꺼서 닫는다(keycloak/README.md).
    # 정확 경로 둘이 아니라 대소문자를 가리지 않는 정규식 하나다(SEA-F05): `account;x=1`(행렬 매개변수 — Keycloak의 경로
    # 대조는 무시한다), `account/…`, `ACCOUNT`, 그리고 nginx가 대조 전에 정규화하는 %-인코딩(`%61ccount`)·겹친 빗금·`/./`·
    # `/../` 표기가 모두 여기서 끝난다. 이 경로 아래에는 prefix `^~` location이 없으므로 정규식이 `/auth/`보다 먼저 맞는다.
    location ~* ^/auth/realms/kin/account { return 404; }

    # Optional, administrator-owned auxiliary routes. Empty on installations
    # without workflow collection; no credentials or captured data live here.
    include /etc/nginx/workflow/*.conf;

    # 토큰이 브라우저 저장소에 남는 이행 기간에는 외부 스크립트와 외부 연결을 막아
    # XSS의 계정 탈취 반경을 줄인다. inline은 현 단일 HTML 프론트 때문에 아직 필요하다.
    # 페이지를 포함한 기본 정책은 WASM 컴파일을 허용하고 JavaScript eval/new Function은 차단한다.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'self' blob:; frame-src 'self' blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # 뷰어 앱 파일의 캐시(위 map). 보안 헤더와 같은 수준에 두어 /ohif/ location이 보안 헤더와 함께 물려받는다 — location에
    # add_header를 따로 두면 위 보안 헤더의 상속이 끊긴다. 값이 빈 경로(/ohif/ 밖)에는 아무 머리글도 붙지 않는다.
    add_header Cache-Control $kin_app_cache_control always;
    # 제품 오류 화면(@kin_error_page)에만 값이 있다(위 map).
    add_header Cross-Origin-Opener-Policy $kin_error_opener_policy always;
    add_header Cross-Origin-Embedder-Policy $kin_error_embedder_policy always;

    # 직접 DICOM 요청의 인증 거절이 어느 거절인지(S7-U5): 인증 서브요청(/kin-authz)은 본문을 전달하지 못하므로 API가
    # 실은 X-KIN-Auth-Code를 보호 경로의 401/403 응답에 그대로 옮긴다. 값이 비면 nginx는 이 헤더를 내지 않는다 —
    # 코드 없는 403은 평범한 열람 거절이다. 위 세 보안 헤더와 같은 수준에 두어야 보호 location이 넷을 함께 물려받는다.
    set $kin_auth_code "";
    add_header X-KIN-Auth-Code $kin_auth_code always;
    # nginx가 머리글을 읽다 끝낸 요청(잘못된 머리글 줄·중복 Host·494/400·414)은 위 set(rewrite 단계)에 닿지 않아 오류 응답의
    # add_header가 이 변수를 미초기화로 읽고, 그 경고(notice)는 요청 줄을 query째 이미지 오류 기록에 싣는다 — archive grant
    # 포함(SRU4R3-1). 이 변수는 지금처럼 set + auth_request_set으로 두고(map 기본값으로도 바꿀 수 있지만 그 선택이 필요한 것은
    # 아니다), 이 server에서 미초기화로 읽힐 수 있는 변수가 이것 하나이며 그때 값은 비어(머리글을 내지 않는다) 경고가 알려 줄
    # 것이 없으므로 경고를 끈다(U4C3-2).
    uninitialized_variable_warn off;

    # grant가 실린 요청의 기록(위 map). archive location은 자기 access_log를 둔다. archive 경로 밖의 grant 키는 location을
    # 고르기 전에 400으로 끝나 upstream·deny·workflow location에 닿지 않으므로 원문 오류 기록이 생기지 않는다.
    access_log /var/log/nginx/access.log main if=$kin_plain_log;
    access_log /var/log/nginx/access.log kin_original_archive if=$kin_grant_query;
    if ($kin_grant_outside_archive) { return 400; }

    # 사람이 브라우저로 연 주소가 실패하면 보는 화면은 이 한 장이다(무엇이 안 됐는지 한 줄, 워크리스트·로그인으로 가는 길,
    # 서버 이름·판 번호 없음). nginx가 스스로 만드는 실패(닫힌·없는 주소, 로그인 관문의 401/403, 본문 한도 413, 뒷단이 죽거나
    # 늦은 502/504)는 어느 location에서든 여기로 온다. 뒷단이 보낸 실패는 그대로 지나간다 — API·인증 서버의 JSON과 상태는
    # 화면 코드가 읽는다. 뒷단의 실패를 이 화면으로 바꾸는 곳은 사람이 여는 화면 폴더(/worklist/, /ohif/)뿐이다
    # (proxy_intercept_errors). 400은 넣지 않는다: grant 거절(위 if)의 기록 규칙을 건드리지 않는다.
    error_page 401 403 404 408 413 500 502 503 504 @kin_error_page;

    # 이름 붙은 location이라 server 수준의 rewrite(`set $kin_auth_code ""`)를 다시 돌지 않는다 — 로그인 관문이 실은
    # X-KIN-Auth-Code가 그대로 남고(화면은 상태와 이 머리글로 세션 종료를 가린다), 위 보안 머리글·캐시 머리글을 물려받는다
    # (그래서 여기 add_header를 두지 않는다). 화면은 정적 파일이 아니라 이 return의 글이다: 정적 파일 처리는 POST를 405로
    # 바꾸지만 return은 요청 방법과 관계없이 원래 상태(error_page가 정한 것)로 나간다. 프록시 설정 안에 있으므로 뒷단이 모두
    # 죽어도 나온다. 화면에는 상태와 정해진 문장만 들어간다 — 요청 주소·query·환자 자료는 싣지 않는다. 스크립트 없이 읽힌다.
    # types를 비우는 것은 원래 주소의 확장자(.js 등)로 형식이 정해지지 않게 하려는 것이다.
    location @kin_error_page {
        set $kin_error_page "error:";
        types { }
        default_type text/html;
        charset utf-8;
        return 200 "<!doctype html>
<html lang='ko'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<meta name='robots' content='noindex'>
<title>HALO PACS</title>
<link rel='icon' type='image/svg+xml' href='/kin-brand/kin-emblem-j1.svg'>
<style>
body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #0f1720; color: #e6edf3; font: 16px/1.6 system-ui, 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; }
main { box-sizing: border-box; width: 100%; max-width: 32rem; padding: 2rem 1.5rem; }
h1 { margin: 0 0 1rem; font-size: 1.25rem; }
.line { margin: 0 0 .25rem; font-size: 1.05rem; overflow-wrap: anywhere; }
.code { margin: 0 0 1.5rem; color: #9aa7b4; font-size: .875rem; }
nav { display: flex; flex-wrap: wrap; gap: .75rem; }
a { color: #7cc4ff; }
</style>
</head>
<body>
<main>
<h1 translate='no'>HALO PACS</h1>
<p class='line'>$kin_error_line</p>
<p class='code'>오류 번호 <span translate='no'>$status</span></p>
<nav><a href='/worklist/hpacs-lite/main.html'>워크리스트로 돌아가기</a> <a href='/worklist/hpacs-lite/index.html'>로그인 화면으로</a></nav>
</main>
</body>
</html>
";
    }

    location = / { return 302 /worklist/hpacs-lite/index.html; }

    # This directory contains only the collector's four-field public heartbeat.
    # No backup/state/credential directory is mounted into nginx for monitoring.
    location = /ops-status.json {
        alias /var/run/kin-monitor-public/status.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    # 가입 신청은 BFF가 state·PKCE를 만든 뒤 Keycloak으로 보낸다. IP별 요청 수 제한은 두지 않는다: 병원의 여러 사용자가
    # 한 IP를 공유한다. 가입한 계정은 관리자 승인 전에는 업무 권한이 없고, 계정별 로그인 실패 잠금은 렐름 설정에 남는다.
    location = /api/auth/register {
        client_max_body_size 2m;
        proxy_pass http://api:3000;
    }

    location = /api/dicom-import {
        # DICOM 객체는 크기로 거절하지 않는다. 나머지 /api/는 2m 그대로.
        client_max_body_size 0;
        proxy_pass http://api:3000;
    }

    # S9-U4b 원본 archive GET(D1489): 브라우저 자체 다운로드의 일회용 grant가 query에 실린다. 이 location은 위
    # kin_original_archive 형식으로만 기록하고, nginx 원문 오류 기록(요청 줄을 그대로 싣는다)은 남기지 않는다 — 진단은
    # API의 감사·상태로 한다. 큰 archive는 버퍼링 없이 흘린다(수신·저장의 증명은 아니다). 정규식이라 /api/보다 먼저 맞는다.
    location ~ ^/api/studies/[0-9.]+/original-downloads/[0-9a-f-]+/archive$ {
        access_log /var/log/nginx/access.log kin_original_archive;
        error_log /dev/null;
        proxy_buffering off;
        client_max_body_size 2m;
        # Connection을 비워야 upstream keepalive가 된다. 이 location이 proxy_set_header를 두므로 서버 수준의 것을 그대로 다시 둔다.
        proxy_set_header Connection        "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  ${PUBLIC_PORT};
        proxy_pass http://kin_api_archive;
    }

    # 받아쓰기 녹음(16 kHz 모노 PCM16 WAV, 초당 32,000 byte). 정확한 상한은 API가 KIN_ASR_MAX_BYTES로 강제한다(기본 180초 분량).
    # 여기 본문 상한은 15-kin-config.envsh가 같은 설정에서 만든다 — 설정을 올리면 프록시도 함께 올라가 둘이 어긋나지 않는다.
    # API의 경로 판정(dictation-parser.ts)과 같은 모양이며 대소문자를 가리지 않는다. 정규식이라 /api/보다 먼저 맞는다.
    location ~* ^/api/studies/[^/]+/dictation/?$ {
        include /etc/nginx/snippets/dictation-body.conf;
        proxy_pass http://api:3000;
    }

    # FC-076 Attach Document: 요청 하나에 PNG·PDF 파일 하나(본문 그대로; JPG는 화면이 PNG로 바꿔 보낸다). 정확한 상한
    # (PDF 20MB, PNG 64MB)과 그 거절 문구(413)는 API가 정한다(study-attachment-parser.ts). 여기 상한은 그보다 조금 커서
    # 상한을 조금 넘는 파일도 API의 문구를 받는다.
    # 정규식이라 /api/보다 먼저 맞는다. 같은 경로의 GET(붙은 문서 목록)은 본문이 없다.
    location ~ ^/api/studies/[0-9.]+/attachments$ {
        client_max_body_size 65m;
        proxy_pass http://api:3000;
    }

    location /api/ {
        # 판독문·필터·상용구 JSON뿐이다. 2MB면 넉넉하고, 그 이상은 실수 아니면 공격이다.
        client_max_body_size 2m;
        proxy_pass http://api:3000;
    }

    location = /auth/realms/kin/login-actions/registration {
        proxy_pass http://keycloak:8080;
        proxy_buffer_size       16k;
        proxy_buffers        8  16k;
        proxy_busy_buffers_size 32k;
    }

    location = /auth/realms/kin/protocol/openid-connect/token {
        proxy_pass http://keycloak:8080;
        proxy_buffer_size       16k;
        proxy_buffers        8  16k;
        proxy_busy_buffers_size 32k;
    }

    # 토큰과 쿠키가 커서 기본 프록시 버퍼로는 응답 헤더가 넘칠 수 있다.
    location /auth/ {
        # Keycloak 로그인 템플릿은 단일 favicon.ico 링크만 낸다. 테마 템플릿을
        # 복제하지 않고 그 링크만 J1 SVG + 32px PNG 폴백으로 확장한다.
        proxy_set_header Accept-Encoding "";
        # 이 location이 자기 proxy_set_header를 두므로 서버 수준의 것은 물려받지 않는다(S7-U5 A007): 접속지를 여기서
        # 다시 정하지 않으면 클라이언트가 보낸 X-Real-IP·X-Forwarded-For가 그대로 Keycloak에 닿는다. 프록시가 본 주소로
        # 덮어쓴다 — 클라이언트가 보낸 값은 이어 붙이지 않고 버린다.
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://keycloak:8080;
        proxy_buffer_size       16k;
        proxy_buffers        8  16k;
        proxy_busy_buffers_size 32k;
        sub_filter_once off;
        sub_filter 'img/favicon.ico" />' 'img/halo-icon.svg" type="image/svg+xml" /><link rel="icon" type="image/png" sizes="32x32" href="/kin-brand/kin-favicon-32.png" />';
    }

    # 브라우저에 Orthanc 자격증명을 주지 않는다. 공개 경로 일곱 곳이 같은 include를
    # 읽어야 비밀번호 교체 때 한 곳만 낡은 헤더로 남는 일이 없다.
    location /worklist/ {
        # OHIF와 같은 cross-origin isolation 상태와 browsing context group에 남아야
        # 이름 붙인 팝업 핸들이 navigation 뒤에도 산다.
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
        # 없는 화면 파일·뒷단 실패는 Orthanc의 JSON 대신 제품 오류 화면(@kin_error_page)이다.
        proxy_intercept_errors on;
    }

    # 내장 뷰어의 번들을 포크하지 않는다. 브라우저 셸에 필요한 KIN 자산만 프록시가
    # 직접 제공하고, 실제 헤더/도구 브랜딩은 app-config.js의 whiteLabeling이 맡는다.
    location ^~ /kin-brand/ {
        alias /usr/share/nginx/html/kin-brand/;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /ohif/manifest.json {
        alias /usr/share/nginx/html/kin-brand/viewer-manifest.json;
        default_type application/manifest+json;
    }

    # D1891: orthancteam/orthanc:24.12.0의 dicomImageLoader는 이 same-origin URL로 Worker를 만든다(blob 아님).
    # 고정 codec의 embind가 new Function을 쓰므로 이 worker의 응답에만 허용한다. codec 청크와 페이지는 기본 정책을 유지한다.
    # OHIF pin을 바꿀 때 worker 생성 URL과 이 정확 경로를 함께 확인한다; 모든 JS에 적용하는 wildcard로 넓히지 않는다.
    location = /ohif/1927.bundle.497fe7ce9f85fada0cc8.js {
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Cache-Control;
        # 이 location은 자기 add_header를 두므로 서버 수준의 캐시 머리글도 여기서 다시 둔다(이름에 해시가 있어 오래 둔다).
        add_header Cache-Control $kin_app_cache_control always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'self' blob:; frame-src 'self' blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'" always;
        # location의 add_header는 상위 헤더 전체의 상속을 끊는다. CSP 외의 보안 헤더도 보존한다.
        include /etc/nginx/snippets/hsts.conf;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-KIN-Auth-Code $kin_auth_code always;
    }

    location /ohif/ {
        # sub_filter가 압축된 HTML에는 적용되지 않는다. 번들/CSS는 그대로 통과시키고
        # text/html 응답의 고정 title·favicon 메타만 KIN 브라우저 셸로 바꾼다.
        proxy_set_header Accept-Encoding "";
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
        # 캐시 정책은 서버 수준의 $kin_app_cache_control 하나다. 뷰어 서버가 언젠가 자기 값을 내도 두 값이 겹치지 않게 숨긴다.
        proxy_hide_header Cache-Control;
        # 없는 화면 파일·뒷단 실패는 Orthanc의 JSON 대신 제품 오류 화면(@kin_error_page, no-store)이다. 디코더 worker의 정확
        # 경로(위)는 가로채지 않는다 — 그 응답의 CSP가 따로다.
        proxy_intercept_errors on;
        sub_filter_once off;
        sub_filter '<meta name="application-name" content="OHIF Viewer"/>' '<meta name="application-name" content="HALO PACS 판독 뷰어"/>';
        sub_filter '<meta name="apple-mobile-web-app-title" content="@ohif/app"/>' '<meta name="apple-mobile-web-app-title" content="HALO PACS 판독 뷰어"/>';
        sub_filter '<meta name="msapplication-TileImage" content="./assets/mstile-144x144.png"/>' '<meta name="msapplication-TileImage" content="/kin-brand/kin-favicon-32.png"/>';
        sub_filter '<link rel="shortcut icon" href="./assets/favicon.ico"/>' '';
        sub_filter '<link rel="icon" type="image/png" sizes="16x16" href="./assets/favicon-16x16.png"/>' '';
        sub_filter '<link rel="icon" type="image/png" sizes="32x32" href="./assets/favicon-32x32.png"/>' '<link rel="icon" type="image/svg+xml" href="/kin-brand/kin-emblem-j1.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/kin-brand/kin-favicon-32.png"/>';
        sub_filter '<link rel="icon" type="image/png" sizes="228x228" href="./assets/coast-228x228.png"/>' '';
        sub_filter '<title>OHIF Viewer</title>' '<title>판독 뷰어 — HALO PACS</title>';
    }

    # EMR-E 영상 경계(E_ROUTE): 뷰어가 원본 픽셀을 받는 WADO-RS 프레임 요청은 Orthanc로 바로 가지 않고 API의 E 경로
    # (images/dicom-web)로 간다. API가 지금의 접근을 확인하고, 보낼 바이트를 고정해 B2 provide-prepared 기록과 함께
    # 확정한 뒤에만 첫 byte를 쓴다 — auth_request의 204는 영상 제공의 기록이 아니다. target은 nginx가 정규화한 $uri뿐이다:
    # 이 정규식이 숫자·점·쉼표·빗금만 통과시키므로 query 구분자가 섞일 수 없고, proxy_pass에 변수가 있으면 원 요청의 query는
    # 붙지 않는다. 전송 끝과 중단을 API가 실제 연결에서 관측하도록 버퍼링하지 않는다(E-03). 메타데이터·렌더링·썸네일 같은
    # 파생 표현과 Gateway STOW는 아래 기존 경로 그대로다.
    # 이 location은 15-kin-config.envsh가 쓴다: E의 manifest는 배포된 뷰어/디코더 자산 목록(KIN_EMR_IMAGE_ASSET_CATALOG)을
    # 고정해야 하므로, 그 목록을 주지 않은 설치에서는 이 location이 비어 있고 프레임 요청은 아래의 다음 프레임 location
    # (MG-LOADING: API의 프레임 range 읽기, 같은 관문과 image-delivery-record.ts의 열람 기록 뒤에 첫 byte)으로 간다. 목록
    # 없이 E로 보내면 뷰어는 503만 받고 영상을 보여주지 못하고, authz 부요청 뒤 Orthanc 직결은 기록 없는 byte다(D1877).
    # 두 location 중 먼저 쓰인 이 쪽이 정규식 순서로 이기므로 목록이 있으면 E, 없으면 range 읽기다.
    include /etc/nginx/snippets/image-frames.conf;

    # 검사 UID를 경로에 박은 STOW만 Gateway에 연다. UID 없는 POST는 아래 읽기 전용
    # location에 남아 403이고, API authz가 announce 선행과 기관 일치를 다시 확인한다.
    # 같은 경로의 GET/HEAD는 검사 전체 영상 읽기다(MG-08 IDR-03): 아래 /dicom-web/ 영상 읽기와 같은 기록 중계로 보낸다.
    # 이 정규식이 그 prefix보다 먼저 맞으므로 여기서 메서드로 나눈다. if 안에서는 return만 쓰고(rewrite 단계), 그 밖의
    # 메서드는 limit_except가 거절한다.
    location ~ ^/dicom-web/studies/[0-9.]+$ {
        client_max_body_size 0;
        limit_except GET HEAD POST { deny all; }
        error_page 418 = @kin_study_image_read;
        # 418로 이미 error_page를 한 번 탔으므로, 이것이 없으면 @kin_study_image_read에서 nginx가 만든 실패(뒷단 502 등)가
        # 제품 오류 화면(server 수준 error_page)으로 가지 못하고 nginx 기본 화면이 된다. 그 location은 418을 다시 내지 않는다.
        recursive_error_pages on;
        if ($kin_image_read_method) { return 418; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        # STOW 수락 객체의 기재 기록을 확정한 뒤 archive 응답을 전달한다. 기존 auth_request는 유지한다.
        rewrite ^/dicom-web/studies/([0-9.]+)$ /api/gateway/stow/$1 break;
        proxy_pass http://api:3000;
    }

    # MG-LOADING (Minhoon P0, 2026-10-27): the viewer's frame reads and the series strip's previews go to the API's
    # range reader (api/src/dicom-frame.service.ts). Measured cause: Orthanc reads and MD5-checks the whole 1 GB DBT
    # file for every frame (2-3.5 s each, serialized). The API runs the same gate as /kin-authz itself, so no
    # auth_request here; it relays to Orthanc what it cannot serve directly. Buffering off: a 17 MB frame streams
    # as it is read instead of being spooled to a temp file first. Regex locations win over the prefix ones below.
    location ~ ^/dicom-web/studies/[0-9.]+/series/[0-9.]+/instances/[0-9.]+/frames/[0-9,]+$ {
        limit_except GET HEAD { deny all; }
        proxy_buffering off;
        proxy_pass http://api:3000/api$request_uri;
    }
    location ~ ^/instances/[0-9a-f-]+/preview$ {
        limit_except GET HEAD { deny all; }
        proxy_pass http://api:3000/api$request_uri;
    }

    # 4242만 닫아도 STOW-RS가 열려 있으면 HTTPS로 영상을 쓸 수 있다.
    # 조회도 먼저 API의 토큰 검증을 통과해야 Orthanc 자격증명을 대신 붙인다.
    # QIDO 목록·DICOMweb metadata도 환자/임상 필드를 반환하므로 제23조④ 열람 대상이다(CD-10).
    # 기존 auth_request를 유지하고, API 중계가 세션의 기존 열람을 대조·기록한 뒤 원문을 전달한다.
    # HEAD는 환자/임상 본문을 전달하지 않는 헤더 확인이므로 전자의무기록 열람을 기록하지 않는다.
    # 조회 권한 관문은 기존 기관·검사 범위를 그대로 확인한다.
    location ~ ^/dicom-web/(studies|series|instances|studies/[0-9.]+/(series|instances|series/[0-9.]+/instances)|studies/[0-9.]+(/series/[0-9.]+(/instances/[0-9.]+)?)?/metadata)$ {
        limit_except GET HEAD { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://api:3000/api/image-relay$request_uri;
    }

    # MG-08(D1877(2)): 영상 바이트(WADO-RS frame·rendered·thumbnail·bulk·객체 전체)는 API의 기록 중계로 간다. auth_request는
    # 읽기를 허락할 뿐 전달을 보지 못해, 이 경로로 Orthanc가 직접 보내면 검사 열람 기록(provide-prepared → 종결)이 남지 않았다.
    # API가 같은 DICOMweb 관문을 돌고 기록이 durable해진 뒤에만 Orthanc의 답을 그대로 흘린다. 버퍼링 없이 흘려 큰 프레임을
    # 임시 파일에 쌓지 않는다. 위 정규식 location이 이 prefix보다 먼저 맞는다.
    location /dicom-web/ {
        limit_except GET HEAD { deny all; }
        proxy_buffering off;
        proxy_pass http://api:3000/api/image-relay/dicom-web/;
    }

    # 위 검사 UID location의 GET/HEAD. 정규식이 맞은 $uri는 숫자와 점뿐이고, query는 rewrite가 그대로 붙인다.
    location @kin_study_image_read {
        proxy_buffering off;
        rewrite ^ /api/image-relay$uri break;
        proxy_pass http://api:3000;
    }

    # 워크리스트 미리보기·썸네일(frames/N/rendered), 판독문·출력 화소(image-uint16/int16), strip preview, pdf 등 저장 객체의
    # 모든 읽기. 태그 설명도 중계에서 별도 열람을 기록한다. 읽기만 — DELETE /instances/{id}는 영상을 지운다.
    location /instances/ {
        limit_except GET HEAD { deny all; }
        proxy_buffering off;
        proxy_pass http://api:3000/api/image-relay/instances/;
    }

    location = /statistics {
        # 환자/임상 필드 없는 저장소 집계는 전자의무기록 열람이 아니다. 영상 프레임은 위 기존 기록 경로가 담당한다.
        limit_except GET HEAD { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    location = /system {
        # 버전·기능 등 서버 정보만 반환하고 환자/임상 필드가 없으므로 전자의무기록 열람이 아니다.
        limit_except GET HEAD { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    # 내부 인증 서브요청 — API가 Bearer 토큰 또는 kin_sid 쿠키의 로그인 세션을 검증한다.
    # 2xx면 통과하고 401/403이면 원 요청도 거부한다. 외부에서는 직접 부를 수 없다.
    # 401 = 자격 없음·끝난 세션, 403 + X-KIN-Auth-Code = 세션 결속 문제, 코드 없는 403 = 열람 거절(S7-U5).
    location = /kin-authz {
        internal;
        proxy_pass http://api:3000/api/authz/dicom;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        # 접속지(S7-U5 A007). 이 location은 자기 proxy_set_header를 두어 서버 수준의 X-Real-IP를 물려받지 않는다 — 여기서
        # 정하지 않으면 영상 요청이 끝낸 세션(유휴 만료·갱신 거절)의 접속기록에 주소가 없거나, 클라이언트가 보낸 값이
        # 남는다. 프록시가 본 원 요청의 주소로 덮어쓴다(서브요청의 $remote_addr는 원 요청의 것이다).
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # 요청을 시작한 문서가 본 세션의 식별값. API는 이것이 쿠키의 세션과 다르면 거절한다 — 다른 탭의 새 로그인이
        # 옛 문서의 영상 요청을 대신 인증하지 않는다. 쿠키 만료(Set-Cookie)는 이 서브요청에서 원 응답으로 옮기지 않는다.
        proxy_set_header X-KIN-Session $http_x_kin_session;
    }

    # 목록에 없는 Orthanc 관리·삭제 경로는 뒷단으로 넘기지 않는다. 잘못 친 주소·옛 즐겨찾기도 여기로 오므로 본문 없는
    # 404로 끝내 제품 오류 화면(@kin_error_page)을 보인다(본문을 주면 error_page를 건너뛴다).
    location / { return 404; }
}
